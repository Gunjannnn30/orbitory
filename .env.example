# ---------------------------------------------------------------------------
# Orbitory environment configuration
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# App
APP_URL="http://localhost:3000"
NODE_ENV="development"

# PostgreSQL (local embedded dev DB defaults shown)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/orbitory?schema=public"

# Optional: test database used by integration tests
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/orbitory_test?schema=public"

# Session
SESSION_TTL_DAYS="30"

# ---------------------------------------------------------------------------
# Local embedded PostgreSQL control (scripts/db.mjs)
# ---------------------------------------------------------------------------
PG_PORT="5432"
PG_USER="postgres"
PG_PASSWORD="postgres"
PG_DATABASE="orbitory"
PG_TEST_DATABASE="orbitory_test"
PG_DATA_DIR=".pgdata"
